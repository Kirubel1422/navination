# Copy to ".env" in the repository root; docker compose reads it automatically.

# --- AI agent (required) -------------------------------------------------------
# NaviNation answers every request with an AI agent on an OpenAI-compatible
# Chat Completions API. Without a model, searches, plans and the coach return
# "AI unavailable". The model must support function (tool) calling.
#   OpenAI:  leave AI_PROVIDER_BASE_URL empty, set AI_API_KEY and AI_MODEL.
#   Others (Azure OpenAI, OpenRouter, vLLM, Ollama, LM Studio): set the /v1 base URL.
#   A server on your host machine is reachable from Docker at http://host.docker.internal:<port>/v1
AI_PROVIDER=openai_compatible
AI_MODEL=
AI_API_KEY=
AI_PROVIDER_BASE_URL=

# --- Official-web tools ----------------------------------------------------------
# The agent may read pages on these domains (HTTPS only). Web search additionally
# needs a Tavily or Brave Search API key; without it the agent can still read
# official pages it already knows about.
OFFICIAL_DOMAINS=u.ae,gov.ae,tamm.abudhabi,uaepass.ae,bayanat.ae,ajman.ae
WEB_FETCH_ENABLED=true
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=

# --- Ports and sessions --------------------------------------------------------
# Change if 3000/8000 are already in use on your machine.
NAVINATION_WEB_PORT=3000
NAVINATION_API_PORT=8000
SESSION_TTL_HOURS=24

# Open data: mirror Bayanat / Ajman Data daily in the background (bundled copies serve until then).
OPEN_DATA_SYNC=true
OPEN_DATA_MAX_AGE_HOURS=24
