# Copy to apps/api/.env (the setup script does this for you). Never commit real secrets.
APP_ENV=development
# SQLite by default (file lives in apps/api/data/). PostgreSQL example:
#   DATABASE_URL=postgresql+psycopg://navination:password@localhost:5432/navination
DATABASE_URL=sqlite:///./data/navination.db
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_TTL_HOURS=24
LOG_LEVEL=INFO

# AI agent (required). NaviNation answers every request with an AI agent on an
# OpenAI-compatible Chat Completions API. There is no rule-based fallback: without a model,
# search, plans and the coach return "AI unavailable" (HTTP 503).
#   OpenAI:        AI_PROVIDER_BASE_URL empty, AI_API_KEY=sk-..., AI_MODEL=<a tool-calling model>
#   Azure/OpenRouter/vLLM/Ollama/LM Studio: set AI_PROVIDER_BASE_URL to the server's /v1 URL.
#   The model must support function (tool) calling.
AI_PROVIDER=openai_compatible
AI_MODEL=
AI_API_KEY=
AI_PROVIDER_BASE_URL=
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=1
AGENT_MAX_STEPS=10
AGENT_DEADLINE_SECONDS=150

# Official-web tools. Pages are fetched only over HTTPS from these domains and subdomains.
OFFICIAL_DOMAINS=u.ae,gov.ae,tamm.abudhabi,uaepass.ae,bayanat.ae,ajman.ae
WEB_FETCH_ENABLED=true
WEB_FETCH_TIMEOUT_SECONDS=10
# Optional web search for the agent: none | tavily | brave (needs WEB_SEARCH_API_KEY).
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=

# Limits
MAX_REQUEST_BYTES=32768
SESSION_CREATE_LIMIT_PER_MINUTE=20
COACH_LIMIT_PER_MINUTE=12
DISCOVER_LIMIT_PER_MINUTE=30
PLAN_LIMIT_PER_MINUTE=10
