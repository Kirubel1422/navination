# Copy to .env.local. Only NEXT_PUBLIC_ values reach the browser; never put secrets here.
# Base URL of the FastAPI service, including /api/v1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# live = real FastAPI backend (normal). mock = isolated MSW demo data with a visible "Demo data" badge.
NEXT_PUBLIC_API_MODE=live
